# copy this file to .env and change what you need. every line is optional.

# your public tunnel url. only used to show the full webhook url in the dashboard
# LOCALFILL_PUBLIC_URL=https://alerts.example.com

# ignore an identical signal that comes in again within this many seconds (0 = off)
# LOCALFILL_DEDUPE_SECONDS=2

# DEBUG, INFO, WARNING, ERROR
# LOCALFILL_LOG_LEVEL=INFO

# tradovate's web client version. change it if logins suddenly fail after a tradovate update
# LOCALFILL_TRADOVATE_APP_VERSION=3.261030.0

# only for the cloudflare tunnel (docker compose --profile tunnel up -d)
# CLOUDFLARE_TUNNEL_TOKEN=

# only for the fake tradovate (docker compose --profile mock up -d)
# LOCALFILL_TRADOVATE_DEMO_URL=http://mock:9000/v1
